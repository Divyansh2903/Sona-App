# Sona environment (see SONA_TECHNICAL_PLAN.md §7).
#
# `EXPO_PUBLIC_*` vars are inlined into the JS bundle by Metro and are readable by anyone
# who unpacks the APK. The non-prefixed vars are passed through `app.config.ts` -> `extra`
# and are ALSO bundled. Nothing here is secret. See §9 for the hardening path.
#
# Copy to `.env` and fill in.

# --- Firebase ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Solana ---
# Helius or any RPC provider. Public devnet endpoint works but is heavily rate limited.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
# Base58 pubkey that receives mint + shop fees.
TREASURY_WALLET=
# Optional: unverified collection mint used to group Sona NFTs (§6.8 instruction 6).
EXPO_PUBLIC_NFT_COLLECTION_MINT=
# Base URL serving catalog/{catalogId}/metadata.json + image.png (§6.6).
EXPO_PUBLIC_CATALOG_BASE_URI=

# --- Crypto ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=

